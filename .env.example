# Atlas Environment Variables

# Database
DATABASE_URL=postgresql+asyncpg://atlas:atlas_password@localhost:5432/atlas_db

# Redis
REDIS_URL=redis://localhost:6379/0

# App Configuration
APP_NAME=Atlas
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Worker / Lease settings
DEFAULT_LEASE_DURATION_SECONDS=30
HEARTBEAT_INTERVAL_SECONDS=10
LEASE_REAPER_INTERVAL_SECONDS=15
